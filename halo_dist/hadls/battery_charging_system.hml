// Profiles built-in

//| Profile       | Required Attributes                        | Notes                      |
//|---------------|--------------------------------------------|----------------------------|
//| SharedMemory  | memSize, baseAddress                       | Set values per task sheet. |
//| BlackBoard    | maxPayload, bufferSize, baseAddress        | Set values per task sheet. |
//| EventChannel  | eventQueueSize, maxChannels, baseAddress   | Set values per task sheet. |
// Insert built-in profiles for common communication patterns.
// if you don't need to override the default values, you can just reference these profiles without attributes EventChannel eventChannelProfile { }
// If you are referencing built-in profiles don't forgert to use --include-stdlib-profiles when composing your system.
Profiles {
    SharedMemory SensorSharedMemory {
        memSize: 512
        syncBlocking: True
        baseAddress: 0x80340000
    }
    SharedMemory ChargingSharedMemory {
        memSize: 512
        syncBlocking: True
        baseAddress: 0x80341000
    }
    BlackBoard ChargingBlackBoard {
        maxPayload: 32
        bufferSize: 64
        baseAddress: 0x80342000
    }
    BlackBoard SafetyBlackBoard {
        maxPayload: 32
        bufferSize: 64
        baseAddress: 0x80343000
    }
    EventChannel OperatorEventChannel {
        eventQueueSize: 16
        maxChannels: 1
        baseAddress: 0x80344000
    }
}
