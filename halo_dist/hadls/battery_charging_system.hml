// Profiles built-in

//| Profile       | Required Attributes                        | Notes                      |
//|---------------|--------------------------------------------|----------------------------|
//| SharedMemory  | memSize, baseAddress                       | Set values per task sheet. |
//| BlackBoard    | maxPayload, bufferSize, baseAddress        | Set values per task sheet. |
//| EventChannel  | eventQueueSize, maxChannels, baseAddress   | Set values per task sheet. |
// override profile attributes if needed or delete not overriden attributes as they are in built-in HMML file --include-stdlib-profiles
SharedMemory SensorMemoryProfile1 {
    memSize: 512
    syncBlocking: True
    baseAddress: 0x80340000 
}
SharedMemory ChargingMemoryProfile1 {
    memSize: 512
    syncBlocking: True
    baseAddress: 0x80341000  
}
// override profile attributes if needed or delete not overriden attributes as they are in built-in HMML file --include-stdlib-profiles
BlackBoard ChargingBoardProfile {
    maxPayload: 64
    bufferSize: 64
    baseAddress: 0x80342000 
}
BlackBoard SafetyBoardProfile {
    maxPayload: 64
    bufferSize: 64
    baseAddress: 0x80343000 
}

// override profile attributes if needed or delete not overriden attributes as they are in built-in HMML file --include-stdlib-profiles
EventChannel OperatorChannelProfile {
    eventQueueSize: 16
    maxChannels: 1
    baseAddress: 0x80344000 
}


